# Henty Server Configuration Example
# Copy this file to .env and configure for your setup

# Server Network Settings
# 0.0.0.0 allows remote access, 127.0.0.1 for local only
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SERVER_DEBUG=False

# Authentication
# IMPORTANT: Set REQUIRE_AUTH=True for remote access!
REQUIRE_AUTH=True
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secret-api-key-here

# CORS - Allowed Origins
# Use * for any origin (less secure) or specify allowed origins:
# ALLOWED_ORIGINS=http://192.168.1.10:8080,http://collaborator-pc:8080
ALLOWED_ORIGINS=*

# WebSocket Support (for real-time progress updates)
ENABLE_WEBSOCKET=True

# Max Upload Size (bytes)
MAX_UPLOAD_SIZE=104857600

# Default Gutenberg URL for quick loading
# Example: The Indiscretion of the Duchess by Anthony Hope
DEFAULT_GUTENBERG_URL=https://www.gutenberg.org/cache/epub/4932/pg4932.txt

# Default Voice Sample (file extension agnostic)
# Example: Stoker Extended, Amanda, etc.
DEFAULT_VOICE=Stoker Extended

# Paths and generation limits
COMMON_FILES_DIR=common_files
DEFAULT_PROJECT_DIR=Projects
MAX_CHUNK_SIZE=500
MAX_PARALLEL_GENERATIONS=3

# TTS engine: chatterbox | chatterbox_turbo | kokoro | orpheus
DEFAULT_TTS_MODEL=chatterbox

# Hugging Face token (needed to download the gated Orpheus model). Secret.
HF_TOKEN=your-hugging-face-token

# Set to 1 to skip the pre-flight dependency check after a first good run
SKIP_PRECHECK=0
