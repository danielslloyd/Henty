{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Annotated Text Document Schema",
  "description": "Schema for Project Gutenberg texts with inline annotations, footnotes, images, and hyperlinks",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "author": {"type": "string"},
        "source_url": {"type": "string"},
        "gutenberg_id": {"type": "string"},
        "processed_date": {"type": "string", "format": "date-time"},
        "language": {"type": "string", "default": "en"}
      },
      "required": ["title"]
    },
    "content": {
      "type": "array",
      "description": "Array of paragraphs or content blocks",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["paragraph", "heading", "image", "divider"]
          },
          "level": {
            "type": "integer",
            "description": "Heading level (1-6) for heading types"
          },
          "text": {
            "type": "string",
            "description": "Plain text content of the paragraph"
          },
          "segments": {
            "type": "array",
            "description": "Text segments with optional annotations",
            "items": {
              "type": "object",
              "properties": {
                "text": {"type": "string"},
                "annotations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {"type": "string"},
                      "type": {
                        "type": "string",
                        "enum": ["place", "person", "topic", "term", "footnote", "link"]
                      },
                      "category": {
                        "type": "string",
                        "description": "Subcategory for organization"
                      },
                      "summary": {
                        "type": "string",
                        "description": "Short summary or definition"
                      },
                      "details": {
                        "type": "object",
                        "description": "Type-specific details",
                        "properties": {
                          "coordinates": {
                            "type": "object",
                            "properties": {
                              "lat": {"type": "number"},
                              "lon": {"type": "number"}
                            }
                          },
                          "born": {"type": "string"},
                          "died": {"type": "string"},
                          "period": {"type": "string"},
                          "definition": {"type": "string"},
                          "etymology": {"type": "string"},
                          "modern_equivalent": {"type": "string"}
                        }
                      },
                      "sources": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "title": {"type": "string"},
                            "url": {"type": "string"},
                            "type": {"type": "string", "enum": ["wikipedia", "wikidata", "britannica", "dictionary", "academic", "other"]}
                          }
                        }
                      },
                      "image_url": {"type": "string"},
                      "related_ids": {
                        "type": "array",
                        "items": {"type": "string"}
                      }
                    },
                    "required": ["id", "type"]
                  }
                }
              },
              "required": ["text"]
            }
          },
          "image_url": {"type": "string"},
          "image_caption": {"type": "string"},
          "image_alt": {"type": "string"}
        },
        "required": ["type"]
      }
    },
    "annotations_index": {
      "type": "object",
      "description": "Index of all annotations by ID for quick lookup",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "required": ["metadata", "content"]
}
